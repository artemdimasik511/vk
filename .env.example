# Токен доступа сообщества ВКонтакте (с правами сообщений и управления сообществом)
VK_TOKEN=vk1.a.your_vk_token_here

# Числовой ID группы ВКонтакте (необязательно, бот умеет определять автоматически)
VK_GROUP_ID=

# Ключ Google Gemini API (Основной)
GEMINI_API_KEY=your_gemini_api_key_here

# Резервный ключ Google Gemini API (на случай исчерпания суточных лимитов)
GEMINI_API_KEY_BACKUP=your_backup_gemini_key_here

# Модель Gemini для анализа изображений и аудио
GEMINI_MODEL=gemini-1.5-flash

# База данных SQLite
DB_PATH=student_bot.sqlite

# Прокси для обхода блокировки Gemini по регионам (User location is not supported)
# Формат: http://login:password@ip:port или socks5://login:password@ip:port
GEMINI_PROXY=
HTTP_PROXY=
HTTPS_PROXY=

# Резервный облачный европейский реле-сервер без блокировок (опционально):
GEMINI_RELAY_URL=

# Настройки ЮKassa (1 месяц бесплатно, далее 30 руб на 2 недели / 14 дней)
YOOKASSA_SHOP_ID=1526439
YOOKASSA_SECRET_KEY=your_yookassa_secret_key_here
FREE_TRIAL_DAYS=30
SUBSCRIPTION_PRICE_RUB=30
SUBSCRIPTION_DAYS=14

